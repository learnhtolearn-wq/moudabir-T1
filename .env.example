# Copy this file to .env and fill in your values
# Never commit .env to git

# Example entries:
# DATABASE_URL=
# ANTHROPIC_API_KEY=

# Moudabir has no backend/cloud by design (offline-first, local data only).
# This file exists for local tooling only (e.g. CI signing secrets, Sentry DSN for crash logs).
# SENTRY_DSN=
